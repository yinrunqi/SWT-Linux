# Copy to .env and fill in ( .env is gitignored )
# Before tests: call setup_test_env.bat  OR  . .\setup_test_env.ps1

OPENAI_API_KEY=sk-your-key-here

# AI Ping（当前推荐配置）
OPENAI_BASE_URL=https://aiping.cn/api/v1
VISION_MODEL=GLM-4.6V
PLAN_MODEL=Qwen3.5-397B-A17B

# juheai 备用配置（Web 设置中选择 juheai 即可切换）
JUHEAI_API_KEY=sk-your-juheai-key-here
JUHEAI_BASE_URL=https://api.juheai.top/v1
SW_API_URL=http://localhost:5100
