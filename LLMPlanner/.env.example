# Copy to .env and fill in ( .env is gitignored )
# Before tests: call setup_test_env.bat  OR  . .\setup_test_env.ps1

# TT Switch 本地网关（当前默认；启动方式见 tt_switch_api_examples/README.md）
OPENAI_API_KEY=sk-ttsw-local
OPENAI_BASE_URL=http://127.0.0.1:4200/native
PLANNER_MODEL=gemini-3.5-flash
VISION_MODEL=gemini-3.5-flash
PLAN_MODEL=gemini-3.5-flash

# AI Ping 备用配置（Web 设置中选择 AI Ping 即可切换）
AIPING_API_KEY=sk-your-aiping-key-here
AIPING_BASE_URL=https://aiping.cn/api/v1

# juheai 备用配置（Web 设置中选择 juheai 即可切换）
JUHEAI_API_KEY=sk-your-juheai-key-here
JUHEAI_BASE_URL=https://api.juheai.top/v1

# 自部署的 Qwen3.8-Flash-Next-FP8（provider = qwenlocal；上下文 73728 token，含输入、推理与输出）
QWENLOCAL_API_KEY=sk-your-qwenlocal-key-here
QWENLOCAL_BASE_URL=http://your-qwen-host/v1
SW_API_URL=http://localhost:5100
