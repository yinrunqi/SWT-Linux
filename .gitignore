# ============================================
# 默认：忽略所有
# ============================================
*

# 保留目录结构（否则无法递归匹配）
!*/

# ============================================
# 根目录关键文件
# ============================================
!.gitignore
!CODEBUDDY.md
!README.md
!TEST.md
!run_test.sh
!run_service.bat
!build_service.bat

# 解决方案文件（复现必需）
!SolidWorksTutorial.slnx

# IDE 个人工作区配置 —— 不入库（保持被 * 忽略，此处仅作说明）
# SolidWorksTutorial.code-workspace

# NuGet 包目录 —— 不入库（靠 packages.config 还原，含第三方包自带 README 也一并排除）
packages/**

# ============================================
# 项目文档
# ============================================
!docs/
!docs/*.md

# ============================================
# Chapter1.ConnectToSw — 跟踪复现所需的源码与工程文件
# ============================================
!Chapter1.ConnectToSw/*.cs
!Chapter1.ConnectToSw/README.md
!Chapter1.ConnectToSw/*.csproj
!Chapter1.ConnectToSw/packages.config
!Chapter1.ConnectToSw/App.config
!Chapter1.ConnectToSw/Properties/
!Chapter1.ConnectToSw/Properties/*.cs

# 资源文件（装配体空模板等运行时依赖资源）
!Chapter1.ConnectToSw/resources/
!Chapter1.ConnectToSw/resources/**

# Chapter1.ConnectToSw 构建产物 —— 不入库
Chapter1.ConnectToSw/bin/**
Chapter1.ConnectToSw/obj/**

# ============================================
# LLMPlanner — 跟踪除缓存外的所有文件
# ============================================
!LLMPlanner/**

# LLMPlanner 中需要排除的缓存/生成物
LLMPlanner/venv/**
LLMPlanner/**/__pycache__/**
LLMPlanner/**/.llm_cache/**
LLMPlanner/log/**
LLMPlanner/**/*.log

# SolidWorks 打开文档时生成的临时锁文件，以及装配体冒烟脚本的本地输出
LLMPlanner/**/~$*
LLMPlanner/assembly_smoke/gear_pair_assembly_v2.SLDASM